<!-- 'O playground è scritto isso stesso in htmlemmurt, FratmScript e par-o-css -->
<cristian lingua="it">
  <capa>
    <inciucc nomme="viewport" cuntenuto="width=device-width, initial-scale=1">
    <titolo>par-o-css: 'o playground</titolo>
    <inciucc nomme="description" cuntenuto="Scrive CSS in napoletano, vieste 'a paggena cu 'e classi napoletane e vide subbeto 'o risultato. Fratello di htmlemmurt e FratmScript.">
    <inciucc nomme="og:title" cuntenuto="par-o-css: CSS, ma comme si deve">
    <inciucc nomme="og:description" cuntenuto="Scrive culore: russo e esce color: red. Provalo int'o browser.">
    <inciucc nomme="og:image" cuntenuto="https://bitoesposito.github.io/par-o-css/og.png">
    <inciucc nomme="twitter:card" cuntenuto="summary_large_image">
    <attacca rapporto="icona" addo="favicon.svg" tipo="image/svg+xml">
    <attacca rapporto="alternate" tipo="text/plain" titolo="llms.txt" addo="llms.txt">
    <!-- The theme before the CSS, so the page does not flash -->
    <fratm tipo="text/javascript">
      let scelta = null
      try {
        scelta = localStorage.getItem("parocss:tema")
      } catch {}
      const scuro = scelta === "scuro" || (scelta !== "chiaro" && matchMedia("(prefers-color-scheme: dark)").matches)
      document.documentElement.dataset.tema = scuro ? "scuro" : "chiaro"
    </fratm>
    <attacca rapporto="stile" addo="./src/stile.cess">
  </capa>
  <panz classe="flessibile direzione-colonna altezza-[100dvh] trabocca-nascosto sfunno-paggena culore-scritta">
    <chiamm da="pezzi/testata.emmurt" />
    <core classe="flessibile direzione-colonna cresce altezza-minima-0 trabocca-nascosto">
      <chiamm da="pezzi/guida.emmurt" />
      <chiamm da="pezzi/schede.emmurt" />
      <cascett chi="banco" classe="flessibile direzione-colonna md:griglia md:colonne-2 cresce altezza-minima-0 trabocca-nascosto">
        <chiamm da="pezzi/codice.emmurt" />
        <chiamm da="pezzi/uscita.emmurt" />
      </cascett>
    </core>
    <chiamm da="pezzi/stato.emmurt" />
    <chiamm da="pezzi/aiuto.emmurt" />
    <chiacchier chi="avviso" classe="avviso" ruolo="status" aria-live="polite" annascuso></chiacchier>
    <cascett chi="carica" classe="fisso ncoppa-0 manca-0 destra-0 sotto-0 livello-50 flessibile allinea-cose-miezo giustifica-miezo sfunno-paggena/80 scrittura-grannezza-sm culore-scritta-smorta">
      <scatulell data-t="loading">Carico 'e compilatori…</scatulell>
    </cascett>
    <fratm da="/src/main.fratm" />
  </panz>
</cristian>
