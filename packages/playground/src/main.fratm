// The playground: a .cess and an htmlemmurt page on the left; on the right the
// page dressed in their CSS, the CSS itself and every class of par-o-css

chiamm { EditorView, basicSetup } da "codemirror"
chiamm { EditorState } da "@codemirror/state"
chiamm { css } da "@codemirror/lang-css"
chiamm { htmlLanguage, autoCloseTags } da "@codemirror/lang-html"
chiamm { setDiagnostics, lintGutter } da "@codemirror/lint"
chiamm { HighlightStyle, StreamLanguage, syntaxHighlighting, syntaxTree } da "@codemirror/language"
chiamm { tags } da "@lezer/highlight"
chiamm { init comme initPaggena, compile comme compilaPaggena, vocabulary } da "htmlemmurt/web"
chiamm { init comme initCess, compile comme compilaCess, scan, names } da "par-o-css/web"
chiamm primmoCess da "../esempi/primmo.cess?raw"
chiamm primmaPaggena da "../esempi/primmo.emmurt?raw"
chiamm sbagliato da "../esempi/sbagliato.cess?raw"
chiamm ueMunnoPaggena da "../esempi/ue-munno.emmurt?raw"
chiamm ueMunno da "../../../examples/01_ue_munno.cess?raw"
chiamm pizzeria da "../../../examples/02_pizzeria.cess?raw"
chiamm pizzeriaPaggena da "../../../examples/02_pizzeria.emmurt?raw"
chiamm carta da "../../../examples/pezzi/carta.cess?raw"

chist è ESEMPI = [
    { nomme: "Uè, munno!", cess: primmoCess, paggena: primmaPaggena },
    { nomme: "Sulo CSS napoletano", cess: ueMunno, paggena: ueMunnoPaggena },
    // In the repository the page links the built 02_pizzeria.css
    { nomme: "'A pizzeria, cu nu pezzo", cess: pizzeria, paggena: pizzeriaPaggena.replace("02_pizzeria.css", "stile.cess") },
    { nomme: "Nu sbaglio, apposta", cess: sbagliato, paggena: primmaPaggena },
]
// The files a .cess can paste in with @chiamm
chist è PEZZI = nu bell Map([["pezzi/carta.cess", carta]])
chist è SALVATO = "parocss:codice"

chist è pesca = (chi) => document.getElementById(chi)

// ---------- Editor colours, from the CSS custom properties (light and dark)

chist è colori = HighlightStyle.define([
    { tag: [tags.tagName, tags.keyword, tags.modifier, tags.constant(tags.className)], color: "var(--culore-tag)" },
    { tag: [tags.attributeName, tags.propertyName], color: "var(--culore-proprieta)" },
    { tag: [tags.attributeValue, tags.string, tags.atom, tags.number, tags.unit, tags.color], color: "var(--culore-valore)" },
    { tag: [tags.className, tags.variableName, tags.labelName], color: "var(--culore-classe)" },
    { tag: tags.comment, color: "var(--culore-commento)", fontStyle: "italic" },
    { tag: [tags.angleBracket, tags.punctuation, tags.operator], color: "var(--culore-punteggiatura)" },
])

chist è tema = EditorView.theme({
    "&": { height: "100%", fontSize: "14px", backgroundColor: "var(--culore-carta)", color: "var(--culore-mare)" },
    // .editor clips CodeMirror's outline: the focus shows inside
    "&.cm-focused": { outline: "2px solid var(--culore-accento)", outlineOffset: "-2px" },
    ".cm-scroller": { fontFamily: "var(--scrittura-mono)", lineHeight: "1.6" },
    ".cm-gutters": { backgroundColor: "var(--culore-carta)", color: "var(--culore-commento)", border: "none" },
    ".cm-activeLine, .cm-activeLineGutter": { backgroundColor: "var(--culore-riga-attiva)" },
    "&.cm-focused .cm-cursor": { borderLeftColor: "var(--culore-accento)" },
    "&.cm-focused .cm-selectionBackground, .cm-selectionBackground, ::selection": { backgroundColor: "var(--culore-selezione)" },
})

// ---------- The .cess language
// lang-css reads "culore: russo" with no ";" as a selector, while a .cess ends a
// declaration at the end of the line: this tokenizer knows it, and @applica

chist è PAROLA = /^-*[\p{L}\p{N}_-]+/u
chist è NUMMERO = /^[+-]?(\d+\.?\d*|\.\d+)(%|[a-z]+)?/i

facc tokenCess(stream, s) {
    chist è c = stream.peek()
    si (s.regola === "@applica" && stream.match(/^[^\s;}]+/)) {
        piglie "className"
    }
    si (stream.match(/^"(?:[^"\\]|\\.)*"?/) || stream.match(/^'(?:[^'\\]|\\.)*'?/) || stream.match(/^url\([^)]*\)?/i)) {
        piglie "string"
    }
    si (stream.match(/^@[\w-]+/)) {
        s.regola = stream.current()
        piglie "keyword"
    }
    si (stream.match(/^![\w-]+/)) {
        piglie "keyword"
    }
    si (c === "{" || c === "}") {
        stream.next()
        s.fonn = Math.max(0, s.fonn + (c === "{" ? 1 : -1))
        s.valore = sfòls
        s.regola = ""
        piglie "brace"
    }
    si (c === ";") {
        stream.next()
        s.valore = sfòls
        s.regola = ""
        piglie "punctuation"
    }
    si (c === ":") {
        si (s.prop) {
            stream.next()
            s.prop = sfòls
            s.valore = overo
            piglie "punctuation"
        }
        stream.match(/^::?[\p{L}\p{N}_-]*/u)
        piglie "className.constant"
    }
    si (s.valore && stream.match(/^#[\da-f]{3,8}\b/i)) {
        piglie "number"
    }
    si (stream.match(NUMMERO)) {
        piglie "number"
    }
    si (stream.match(/^[.#][\p{L}\p{N}_-]+/u)) {
        piglie "className"
    }
    si (stream.match(PAROLA)) {
        chist è nomme = stream.current()
        chist è dopo = stream.string.slice(stream.pos)
        // @quanno (larghezza-massima: 600px): the feature is a property
        si (s.regola) {
            s.prop = /^\s*:/.test(dopo)
            piglie s.prop ? "propertyName" : s.valore ? "atom" : "keyword"
        }
        // In a block, "word:" with no "{" after it is a declaration, not a selector
        si (!s.valore && s.fonn > 0 && /^\s*:(?!:)[^{]*$/.test(dopo)) {
            s.prop = overo
            piglie nomme.startsWith("--") ? "variableName" : "propertyName"
        }
        si (s.valore) {
            piglie nomme.startsWith("--") ? "variableName" : "atom"
        }
        piglie "tagName"
    }
    stream.next()
    piglie "punctuation"
}

chist è cessLanguage = StreamLanguage.define({
    name: "cess",
    startState: () => ({ fonn: 0, valore: sfòls, prop: sfòls, regola: "", commento: sfòls, virgola: sfòls }),
    token(stream, s) {
        si (stream.sol()) {
            // A new line ends the declaration, unless the last one ended with a comma
            s.valore = s.valore && s.virgola
            s.prop = sfòls
            s.regola = ""
        }
        si (s.commento || stream.match("/*")) {
            s.commento = !stream.skipTo("*/")
            si (s.commento) {
                stream.skipToEnd()
            } sinnò {
                stream.pos += 2
            }
            piglie "comment"
        }
        si (stream.eatSpace()) {
            piglie nisciun
        }
        chist è stile = tokenCess(stream, s)
        s.virgola = stream.current() === ","
        piglie stile
    },
    indent: (s, dopo, cx) => Math.max(0, s.fonn - (/^\s*\}/.test(dopo) ? 1 : 0)) * cx.unit,
    languageData: { commentTokens: { block: { open: "/*", close: "*/" } }, indentOnInput: /^\s*\}$/ },
})

// ---------- Completion: only the words of htmlemmurt and the classes of par-o-css, never English

tien parole = nisciun
tien classi = []

// The classes, after @applica in the .cess
facc completaCess(ctx) {
    chist è riga = ctx.state.doc.lineAt(ctx.pos)
    si (!/^\s*@applica\s/.test(riga.text.slice(0, ctx.pos - riga.from))) {
        piglie nisciun
    }
    piglie { from: ctx.matchBefore(/\S*/).from, options: classi, validFor: /^\S*$/ }
}

// As @codemirror/lang-html does: element, attribute or value depending on where the cursor is
facc completaPaggena(ctx) {
    si (!parole) {
        piglie nisciun
    }
    chist è nodo = syntaxTree(ctx.state).resolveInner(ctx.pos, -1)
    chist è testo = (n) => ctx.state.sliceDoc(n.from, n.to).toLowerCase()
    chist è nomme = /^[\p{L}\p{N}-]*$/u
    si (["StartTag", "IncompleteTag", "StartCloseTag", "IncompleteCloseTag", "TagName"].includes(nodo.name)) {
        piglie { from: nodo.name === "TagName" ? nodo.from : ctx.pos, options: parole.elementi, validFor: nomme }
    }
    tien tag = nodo
    mentre che (tag && tag.name !== "OpenTag" && tag.name !== "SelfClosingTag") {
        tag = tag.parent
    }
    chist è nommeTag = tag?.getChild("TagName")
    si (!nommeTag) {
        piglie nisciun
    }
    chist è elemento = parole.html[testo(nommeTag)] ?? testo(nommeTag)
    chist è vale = (a) => !a.only || a.only.includes(elemento)
    si (["OpenTag", "SelfClosingTag", "AttributeName"].includes(nodo.name)) {
        chist è visti = nu bell Set()
        chist è opzioni = []
        pe ogni (chist è a dint parole.attributi) {
            si (vale(a) && !visti.has(a.nap)) {
                visti.add(a.nap)
                opzioni.push({ label: a.nap, detail: a.html, type: "property" })
            }
        }
        piglie { from: nodo.name === "AttributeName" ? nodo.from : ctx.pos, options: [...opzioni, ...parole.eventi, ...parole.comeSo], validFor: nomme }
    }
    si (nodo.name === "AttributeValue" || nodo.name === "UnquotedAttributeValue") {
        chist è attributo = nodo.parent.getChild("AttributeName")
        si (attributo && testo(attributo) === "classe") {
            piglie { from: ctx.matchBefore(/[^\s"']*/).from, options: classi, validFor: /^[^\s"']*$/ }
        }
        chist è a = attributo && parole.attributi.find((x) => x.nap === testo(attributo) && vale(x))
        si (!a?.values) {
            piglie nisciun
        }
        chist è virgulette = /^["']/.test(testo(nodo)) ? 1 : 0
        chist è opzioni = a.values.map(([label, detail]) => ({ label, detail, type: "enum" }))
        piglie { from: nodo.from + virgulette, options: opzioni, validFor: /^[^"'\s]*$/ }
    }
    piglie nisciun
}

// ---------- Compiling

// The error under the code, on the wrong word
facc segnala(editor, e, parola) {
    chist è doc = editor.state.doc
    tien diagnosi = []
    si (e && e.line <= doc.lines) {
        chist è riga = doc.line(e.line)
        chist è inizio = Math.min(riga.from + e.column - 1, riga.to)
        chist è trovata = riga.text.slice(e.column - 1).match(parola)
        chist è fine = Math.min(inizio + (trovata ? trovata[0].length : 1), riga.to)
        chist è testoErrore = e.suggestion ? `${e.message}\n${e.suggestion}` : e.message
        diagnosi = [{ from: inizio, to: Math.max(fine, inizio), severity: "error", message: testoErrore }]
    }
    editor.dispatch(setDiagnostics(editor.state, diagnosi))
}

// Writes the status only when it changes, so a screen reader does not repeat it at every key
facc dici(classe, testo) {
    chist è stato = pesca("stato")
    stato.className = classe
    si (stato.textContent !== testo) {
        stato.textContent = testo
    }
}

// The CSS goes where the page links stile.cess, or at the end of its <head>
facc conStile(paggena, foglio) {
    // "</style" in a CSS string would close the tag early
    chist è stile = `<style>${foglio.replaceAll("</style", "<\\/style")}</style>`
    chist è link = /<link\b[^>]*\bhref=["']?(?:\.\/)?stile\.cess["']?[^>]*>/i
    si (link.test(paggena)) {
        piglie paggena.replace(link, () => stile)
    }
    chist è dove = paggena.search(/<\/head>|<body\b/i)
    piglie dove === -1 ? stile + paggena : paggena.slice(0, dove) + stile + paggena.slice(dove)
}

// The preview is a frame with no access to the playground: scripts only
chist è anteprima = document.createElement("iframe")
anteprima.title = "Anteprima"
anteprima.setAttribute("sandbox", "allow-scripts allow-modals allow-forms")
pesca("anteprima").append(anteprima)

chist è uscita = nu bell EditorView({
    parent: pesca("css"),
    state: EditorState.create({
        doc: "",
        extensions: [
            basicSetup,
            css(),
            syntaxHighlighting(colori),
            tema,
            EditorView.lineWrapping,
            EditorState.readOnly.of(overo),
            EditorView.contentAttributes.of({ "aria-label": "CSS compilato" }),
        ],
    }),
})

facc compila() {
    chist è cess = editorCess.state.doc.toString()
    chist è paggena = editorPaggena.state.doc.toString()
    chist è p = compilaPaggena(paggena, { filename: "index.emmurt", inline: overo })
    chist è c = compilaCess(cess, { filename: "stile.cess", classes: scan(paggena), read: (via) => PEZZI.get(via) ?? nisciun })
    chist è erroreCess = c.errors[0]
    segnala(editorPaggena, p.errors[0], /^[^\s"'<>=\/]+/)
    // An error in pezzi/carta.cess is not in the editor: the status line says where it is
    segnala(editorCess, erroreCess?.file === "stile.cess" ? erroreCess : nisciun, /^[^\s:;{}(),"']+(?::[^\s:;{}(),"']+)*/)
    chist è e = p.errors[0] ?? erroreCess
    // With an error the preview and the CSS stay the last good ones, and look old
    pe ogni (chist è vista dint [pesca("anteprima"), pesca("css")]) {
        vista.toggleAttribute("data-vecchia", Boolean(e))
    }
    si (e) {
        dici("stato sbagliato", `✗ ${e.file}, riga ${e.line}, colonna ${e.column}: ${e.message}${e.suggestion ? " " + e.suggestion : ""}`)
        piglie
    }
    dici("stato", "✓ Tutto a posto")
    anteprima.srcdoc = conStile(p.html, c.css)
    uscita.dispatch({ changes: { from: 0, to: uscita.state.doc.length, insert: c.css } })
}

// ---------- The editors

tien attesa = nisciun

chist è quannoCagna = EditorView.updateListener.of((u) => {
    si (!u.docChanged) {
        piglie
    }
    // The code no longer is the one in the link: the local copy wins
    si (location.hash) {
        history.replaceState(nisciun, "", location.pathname)
    }
    clearTimeout(attesa)
    attesa = setTimeout(() => {
        compila()
        pruvamm {
            localStorage.setItem(SALVATO, JSON.stringify(codice()))
        } e si schiatta (e) {
            // With no localStorage (private browsing) only the saving is lost
        }
    }, 200)
})

facc editor(chi, linguaggio, etichetta) {
    piglie nu bell EditorView({
        parent: pesca(chi),
        state: EditorState.create({
            doc: "",
            extensions: [
                basicSetup,
                linguaggio,
                syntaxHighlighting(colori),
                tema,
                EditorView.lineWrapping,
                EditorView.contentAttributes.of({ "aria-label": etichetta }),
                lintGutter(),
                quannoCagna,
            ],
        }),
    })
}

chist è editorCess = editor("cess", [cessLanguage, cessLanguage.data.of({ autocomplete: completaCess })], "stile.cess, CSS napoletano")
chist è editorPaggena = editor("paggena", [htmlLanguage, htmlLanguage.data.of({ autocomplete: completaPaggena }), autoCloseTags], "index.emmurt, 'a paggena in htmlemmurt")

facc codice() {
    piglie { cess: editorCess.state.doc.toString(), paggena: editorPaggena.state.doc.toString() }
}

facc metti({ cess, paggena }) {
    editorCess.dispatch({ changes: { from: 0, to: editorCess.state.doc.length, insert: String(cess ?? "") } })
    editorPaggena.dispatch({ changes: { from: 0, to: editorPaggena.state.doc.length, insert: String(paggena ?? "") } })
}

// ---------- Link to share: both files, compressed, in #codice=

mo vir facc comprimi(testo) {
    chist è flusso = nu bell Blob([testo]).stream().pipeThrough(nu bell CompressionStream("deflate-raw"))
    chist è byte = nu bell Uint8Array(aspett nu bell Response(flusso).arrayBuffer())
    tien binario = ""
    pe ogni (chist è b dint byte) {
        binario += String.fromCharCode(b)
    }
    piglie btoa(binario).replaceAll("+", "-").replaceAll("/", "_").replace(/=+$/, "")
}

mo vir facc decomprimi(base64) {
    chist è binario = atob(base64.replaceAll("-", "+").replaceAll("_", "/"))
    chist è byte = Uint8Array.from(binario, (c) => c.charCodeAt(0))
    chist è flusso = nu bell Blob([byte]).stream().pipeThrough(nu bell DecompressionStream("deflate-raw"))
    piglie aspett nu bell Response(flusso).text()
}

pesca("condividi").addEventListener("click", mo vir () => {
    chist è link = `${location.origin}${location.pathname}#codice=${aspett comprimi(JSON.stringify(codice()))}`
    history.replaceState(nisciun, "", link)
    chist è bottone = pesca("condividi")
    pruvamm {
        aspett navigator.clipboard.writeText(link)
        bottone.textContent = "Link copiato"
    } e si schiatta (e) {
        bottone.textContent = "Copialo d'a barra"
    }
    setTimeout(() => {
        bottone.textContent = "Copia link"
    }, 2000)
})

// ---------- Examples

pe ogni (chist è [i, esempio] dint ESEMPI.entries()) {
    pesca("esempi").append(nu bell Option(esempio.nomme, String(i)))
}
pesca("esempi").addEventListener("change", (evento) => {
    metti(ESEMPI[Number(evento.target.value)])
    // Back to "Scegli…": the editors are no longer the example once touched, and it can be picked again
    evento.target.value = ""
})

// ---------- Tabs: Anteprima, CSS, Classi

chist è schede = [...document.querySelectorAll("[role=tab]")]

facc apri(scheda) {
    pe ogni (chist è s dint schede) {
        chist è attiva = s === scheda
        s.setAttribute("aria-selected", String(attiva))
        s.tabIndex = attiva ? 0 : -1
        pesca(s.getAttribute("aria-controls")).hidden = !attiva
    }
    si (scheda.id === "scheda-css") {
        uscita.requestMeasure()
    }
}

pe ogni (chist è [i, scheda] dint schede.entries()) {
    scheda.addEventListener("click", () => apri(scheda))
    scheda.addEventListener("keydown", (evento) => {
        chist è dove = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: schede.length - 1 }[evento.key]
        si (dove !== undefined) {
            evento.preventDefault()
            chist è prossima = schede[(dove + schede.length) % schede.length]
            apri(prossima)
            prossima.focus()
        }
    })
}

// ---------- Classi

facc tavula(titolo, righe) {
    chist è piezz = document.createElement("section")
    chist è h = document.createElement("h2")
    h.textContent = titolo
    piezz.append(h)
    chist è t = document.createElement("table")
    chist è capo = t.createTHead().insertRow()
    pe ogni (chist è colonna dint ["par-o-css", "Tailwind"]) {
        chist è th = document.createElement("th")
        th.scope = "col"
        th.textContent = colonna
        capo.append(th)
    }
    chist è cuorpo = t.createTBody()
    pe ogni (chist è riga dint righe) {
        chist è r = cuorpo.insertRow()
        pe ogni (chist è cella dint riga) {
            r.insertCell().textContent = cella
        }
    }
    piezz.append(t)
    piglie piezz
}

// ---------- Start

pruvamm {
    aspett Promise.all([initPaggena(), initCess()])
} e si schiatta (e) {
    dici("stato sbagliato", `✗ Nun riesco a carricà 'e compilatori: ${e.message}`)
    iett e
}

chist è v = vocabulary()
parole = {
    elementi: [
        ...v.tags.map(([nap, h]) => ({ label: nap, detail: `<${h}>`, type: "type" })),
        { label: "chiamm", detail: "ncolla n'atu file", type: "type" },
        ...v.untranslated.tags.map((label) => ({ label, detail: "HTML", type: "type" })),
    ],
    html: Object.fromEntries(v.tags),
    attributi: v.attributes,
    eventi: v.events.map(([nap, h]) => ({ label: nap, detail: `${h} (FratmScript)`, type: "event" })),
    // HTML names with no word yet: the compiler lets them pass as they are
    comeSo: [...v.untranslated.attributes, ...v.untranslated.events].map((label) => ({ label, detail: "HTML", type: "property" })),
}

// A root takes a value after "-", a variant goes before a class with ":"
chist è nomi = names()
chist è scritto = (n, nomme) => n.che === "radice" ? `${nomme}-` : n.che === "variante" ? `${nomme}:` : nomme
classi = nomi.map((n) => ({ label: scritto(n, n.nomme), detail: scritto(n, n.tailwind), type: n.che === "classe" ? "class" : n.che === "radice" ? "property" : "keyword" }))
chist è righe = (che) => nomi.filter((n) => n.che === che).map((n) => [scritto(n, n.nomme), scritto(n, n.tailwind)])
pesca("nomi").append(
    tavula("Classi sane", righe("classe")),
    tavula("Radici: radice-valore, comme spazio-4", righe("radice")),
    tavula("Varianti: variante:classe, comme passanno:sottolineato", righe("variante")),
)
pesca("cerca").addEventListener("input", (evento) => {
    chist è cosa = evento.target.value.trim().toLowerCase()
    pe ogni (chist è piezz dint document.querySelectorAll("#nomi section")) {
        pe ogni (chist è r dint piezz.querySelectorAll("tbody tr")) {
            r.hidden = cosa !== "" && !r.textContent.toLowerCase().includes(cosa)
        }
        piezz.hidden = !piezz.querySelector("tbody tr:not([hidden])")
    }
    chist è nisciuna = pesca("nisciuna")
    nisciuna.hidden = Boolean(document.querySelector("#nomi section:not([hidden])"))
    nisciuna.textContent = `Nun trovo "${evento.target.value.trim()}" int'e classi.`
})

tien iniziale = ESEMPI[0]
pruvamm {
    chist è nelLink = location.hash.match(/^#codice=(.+)$/)
    si (nelLink) {
        iniziale = JSON.parse(aspett decomprimi(nelLink[1]))
    } sinnò {
        iniziale = JSON.parse(localStorage.getItem(SALVATO)) ?? iniziale
    }
} e si schiatta (e) {
    // A broken link or no localStorage: start from the example
}
metti(iniziale)
