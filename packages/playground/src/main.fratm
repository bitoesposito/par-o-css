// The playground: stile.cess and index.emmurt on the left; the page, its
// console and the CSS on the right. The look and functions of FratmScript's
// playground, written in htmlemmurt, FratmScript and par-o-css.

chiamm { t, traduci, cagnaLingua, quannoCagnaLingua, lenguaAttuale, nommeLingua, LINGUE } da "./lingua.fratm"
chiamm { mettiIcone, icona } da "./icone.fratm"
chiamm { crea, leggiSalvato, salva } da "./dom.fratm"
chiamm { creaEditor, creaVista, metti, segnala, vaiA, imparaParole } da "./editor.fratm"
chiamm { carica, compila, arrecetta, arrecettaPaggena, creaAnteprima } da "./paggena.fratm"
chiamm { fotografa, differenza } da "./confronta.fratm"
chiamm { linkPe, codiceDalLink } da "./condividi.fratm"
chiamm { preparaAiuto } da "./aiuto.fratm"
chiamm { LEZIONI, creaScola } da "./scola.fratm"
chiamm { SEZIONI, creaGuida } da "./guida.fratm"
chiamm primmoCess da "../esempi/primmo.cess?raw"
chiamm primmaPaggena da "../esempi/primmo.emmurt?raw"
chiamm sbagliato da "../esempi/sbagliato.cess?raw"
chiamm ueMunnoPaggena da "../esempi/ue-munno.emmurt?raw"
chiamm ueMunno da "../../../examples/01_ue_munno.cess?raw"
chiamm pizzeria da "../../../examples/02_pizzeria.cess?raw"
chiamm pizzeriaPaggena da "../../../examples/02_pizzeria.emmurt?raw"

chist è ESEMPI = [
    { id: "primmo", cess: primmoCess, paggena: primmaPaggena },
    { id: "ueMunno", cess: ueMunno, paggena: ueMunnoPaggena },
    // In the repository the page links the built 02_pizzeria.css
    { id: "pizzeria", cess: pizzeria, paggena: pizzeriaPaggena.replace("02_pizzeria.css", "stile.cess") },
    { id: "sbagliato", cess: sbagliato, paggena: primmaPaggena },
]

chist è SALVATO = "parocss:codice"
chist è AUTOMATICO = "parocss:automatico"
chist è TEMA = "parocss:tema"
chist è CODICE_LEZIONE = "parocss:scola:"
chist è FATTE = "parocss:scola:fatte"
chist è ATTESA_MS = 700

// The two files of the project and their key in the code
chist è CHIAVE = { "stile.cess": "cess", "index.emmurt": "paggena" }

chist è pesca = (chi) => document.getElementById(chi)
chist è tutti = (selettore) => [...document.querySelectorAll(selettore)]

// ---------- State

tien file = { cess: "", paggena: "" }
tien aperto = "stile.cess"
tien ultimoLanciato = nisciun
tien pronto = sfòls
tien versioni = nisciun
tien automatico = leggiSalvato(AUTOMATICO) !== "false"
tien esempio = ""
tien lezione = nisciun
tien sezione = nisciun
tien scheda = "codice"
tien attesa = nisciun
tien mettenno = sfòls
tien soluzioni = nu bell Map()
tien fatte = nu bell Set()
pruvamm {
    fatte = nu bell Set(JSON.parse(leggiSalvato(FATTE) ?? "[]"))
} e si schiatta (e) {
    // A broken save: start again
}

facc uguale(a, b) {
    piglie a.cess === b.cess && a.paggena === b.paggena
}

// The saved files, or null when missing or broken
facc leggiFile(chiave) {
    pruvamm {
        chist è { cess, paggena } = JSON.parse(leggiSalvato(chiave))
        piglie typeof cess === "string" && typeof paggena === "string" ? { cess, paggena } : nisciun
    } e si schiatta (e) {
        piglie nisciun
    }
}

facc salvaFile() {
    salva(lezione === nisciun ? SALVATO : CODICE_LEZIONE + LEZIONI[lezione].id, JSON.stringify(file))
}

// ---------- Header: language and theme

pe ogni (chist è scegli dint tutti(".scegli-lingua")) {
    scegli.append(...LINGUE.map((l) => nu bell Option(nommeLingua(l), l)))
    scegli.value = lenguaAttuale()
    scegli.addEventListener("change", (evento) => cagnaLingua(evento.target.value))
}

chist è scuroD_oSistema = matchMedia("(prefers-color-scheme: dark)")

facc applicaTema() {
    chist è scelta = leggiSalvato(TEMA) ?? "sistema"
    chist è scuro = scelta === "scuro" || (scelta === "sistema" && scuroD_oSistema.matches)
    document.documentElement.dataset.tema = scuro ? "scuro" : "chiaro"
    pe ogni (chist è scegli dint tutti(".scegli-tema")) {
        scegli.value = scelta
    }
}

facc scriviTemi() {
    pe ogni (chist è scegli dint tutti(".scegli-tema")) {
        scegli.replaceChildren(
            nu bell Option(t("theme.system"), "sistema"),
            nu bell Option(t("theme.light"), "chiaro"),
            nu bell Option(t("theme.dark"), "scuro"),
        )
    }
    applicaTema()
}

pe ogni (chist è scegli dint tutti(".scegli-tema")) {
    scegli.addEventListener("change", (evento) => {
        salva(TEMA, evento.target.value)
        applicaTema()
    })
}
scuroD_oSistema.addEventListener("change", applicaTema)

// ---------- Notices, like FratmScript's toasts

tien avvisoTimer = nisciun

facc avvisa(titolo, descrizione) {
    chist è avviso = pesca("avviso")
    avviso.replaceChildren(crea("strong", "blocco scrittura-peso-500", titolo))
    si (descrizione) {
        avviso.append(crea("span", "blocco margine-ncoppa-0.5 culore-scritta-smorta", descrizione))
    }
    avviso.hidden = sfòls
    clearTimeout(avvisoTimer)
    avvisoTimer = setTimeout(() => {
        avviso.hidden = overo
    }, 4000)
}

// ---------- Status bar

facc stato(tipo, testo, tiempo = "") {
    chist è pallino = pesca("stato-pallino")
    chist è culore = { pronto: "sfunno-buono", sbaglio: "sfunno-sbaglio", attesa: "sfunno-attesa", carica: "sfunno-attesa pulsa" }[tipo]
    pallino.className = `pallino ${culore}`
    // For the end-to-end tests, whatever the language
    pesca("barra-stato").dataset.stato = tipo
    chist è scritta = pesca("stato-testo")
    // Only when it changes, so a screen reader does not repeat it at every key
    si (scritta.textContent !== testo) {
        scritta.textContent = testo
    }
    pesca("tiempo").textContent = tiempo
    pesca("tiempo").hidden = !tiempo
    pesca("tiempo-filo").hidden = !tiempo
}

tien ultimoStato = () => stato("carica", t("status.loading"))

// ---------- Output: preview, errors, console, CSS

chist è anteprima = creaAnteprima(pesca("anteprima"), (tipo, testo) => scriviConsole(tipo, testo))
chist è vistaCss = creaVista({ parent: pesca("css"), etichetta: t("output.css") })

facc contaConsole() {
    chist è voci = pesca("console").children.length
    chist è sbagli = pesca("sbagli").children.length + tutti("#console [data-tipo=error]").length
    pesca("console").hidden = voci === 0
    pesca("console-vacante").hidden = voci > 0
    chist è contatore = document.querySelector("[data-contatore]")
    chist è quante = sbagli > 0 ? sbagli : voci
    contatore.hidden = quante === 0
    contatore.toggleAttribute("data-sbagli", sbagli > 0)
    contatore.textContent = quante > 99 ? "99+" : String(quante)
    contatore.setAttribute("aria-label", t(sbagli > 0 ? "tabs.errors" : "tabs.messages", { n: quante }))
}

facc scriviConsole(tipo, testo) {
    chist è voce = crea("li", "voce-console")
    voce.dataset.tipo = tipo
    chist è segno = crea("span", "flessibile margine-ncoppa-0.5 [flex-shrink:0] culore-scritta-smorta")
    segno.innerHTML = icona(tipo === "error" ? "sbaglio" : tipo === "warn" ? "attenzione" : "destra")
    voce.append(segno, crea("span", "cresce", testo))
    pesca("console").append(voce)
    contaConsole()
}

facc cartaSbaglio(e) {
    chist è carta = crea("div", "spazio-3 bordo bordo-sbaglio/20 bordo-tunno-lg sfunno-sbaglio/5 scrittura-grannezza-sm")
    chist è capo = crea("div", "flessibile a-capo allinea-cose-miezo giustifica-spartuto spazio-mmiez-2")
    capo.append(crea("strong", "scrittura-peso-500 culore-sbaglio-scritta", t("error.compile")))
    chist è dove = `${e.file} · ${t("output.lineColumn", { line: e.line, column: e.column })}`
    si (CHIAVE[e.file]) {
        // The error is in a file of the project: the button goes there
        chist è vai = crea("button", "buttone buttone-fantasma buttone-piccolo culore-sbaglio-scritta", dove)
        vai.type = "button"
        vai.addEventListener("click", () => {
            mostraScheda("codice")
            apriFile(e.file)
            requestAnimationFrame(() => vaiA(editori[e.file], e.line, e.column))
        })
        capo.append(vai)
    } sinnò {
        // In a piece, like pezzi/carta.cess: not in the editor
        capo.append(crea("span", "scrittura-mono scrittura-grannezza-xs culore-sbaglio-scritta", dove))
    }
    carta.append(capo, crea("p", "margine-ncoppa-1 scrittura-mono [white-space:pre-wrap]", e.suggestion ? `${e.message}\n${e.suggestion}` : e.message))
    piglie carta
}

facc vecchio(si_) {
    pe ogni (chist è vista dint [pesca("anteprima"), pesca("css")]) {
        vista.classList.toggle("opacità-60", si_)
    }
}

/** Compiles and shows. `daBottone`: asked by the user (Esegui, Ctrl+Enter). */
facc lancia(daBottone = sfòls) {
    si (!pronto) {
        piglie
    }
    clearTimeout(attesa)
    chist è r = compila(file)
    ultimoLanciato = { ...file }
    pe ogni (chist è [nomme, editor] dint Object.entries(editori)) {
        chist è e = r.sbagli.find((x) => x.file === nomme)
        segnala(editor, e)
        document.querySelector(`[data-file-scheda="${nomme}"]`).toggleAttribute("data-sbaglio", Boolean(e))
    }
    pesca("sbagli").replaceChildren(...r.sbagli.map(cartaSbaglio))
    si (r.html === nisciun) {
        // The preview and the CSS stay the last good ones, and look old
        vecchio(overo)
        ultimoStato = () => stato("sbaglio", t("status.compileError"))
    } sinnò {
        vecchio(sfòls)
        pesca("console").replaceChildren()
        anteprima.mostra(r.html)
        metti(vistaCss, r.css)
        chist è tiempo = r.ms.toFixed(1)
        ultimoStato = () => stato("pronto", t("status.done"), t("status.compiledIn", { ms: tiempo }))
        controllaLezione(r.html)
    }
    ultimoStato()
    contaConsole()
    // On phones the output has its own tab: Esegui opens it
    si (daBottone && scheda === "codice" && telefono.matches) {
        mostraScheda(r.html === nisciun ? "console" : "anteprima")
    }
}

// ---------- The editor: a tab per file

facc scriviEsempi() {
    chist è scegli = pesca("esempi")
    scegli.replaceChildren(nu bell Option(t("editor.chooseExample"), ""))
    si (esempio === "proprio") {
        chist è proprio = nu bell Option(t("editor.custom"), "proprio")
        proprio.disabled = overo
        scegli.append(proprio)
    }
    scegli.append(...ESEMPI.map((x) => nu bell Option(t(`ex.${x.id}`), x.id)))
    scegli.value = esempio
    pesca("cagnato").hidden = esempio !== "proprio"
}

facc quannoCagna(nomme, testo) {
    file[CHIAVE[nomme]] = testo
    // mettiFile changes both files: its caller does the rest
    si (mettenno) {
        piglie
    }
    // An edited example becomes your own code
    chist è x = ESEMPI.find((x) => x.id === esempio)
    si (x && !uguale(x, file)) {
        esempio = "proprio"
        scriviEsempi()
    }
    // The code is no longer the link's: the saved copy wins
    si (location.hash.startsWith("#codice=")) {
        history.replaceState(nisciun, "", location.pathname + location.search)
    }
    salvaFile()
    si (!pronto) {
        piglie
    }
    clearTimeout(attesa)
    vecchio(!ultimoLanciato || !uguale(file, ultimoLanciato))
    si (automatico) {
        ultimoStato = () => stato("attesa", t("status.staleAuto"))
        attesa = setTimeout(lancia, ATTESA_MS)
    } sinnò {
        ultimoStato = () => stato("attesa", t("status.staleManual"))
    }
    ultimoStato()
}

/** Puts both files in the editor and saves them; does not run them. */
facc mettiFile(nuovi) {
    mettenno = overo
    metti(editori["stile.cess"], nuovi.cess)
    metti(editori["index.emmurt"], nuovi.paggena)
    mettenno = sfòls
    salvaFile()
}

facc puoArrecettà() {
    piglie aperto === "stile.cess" || arrecettaPaggena !== nisciun
}

facc scriviFormatta() {
    chist è b = pesca("formatta")
    chist è si_ = puoArrecettà()
    b.setAttribute("aria-disabled", String(!si_))
    b.title = si_ ? t("editor.formatTip") : t("editor.formatNoEmmurt", { version: versioni?.emmurt ?? "" })
}

facc arrecettaFile() {
    si (!pronto) {
        piglie
    }
    si (!puoArrecettà()) {
        avvisa(t("editor.format"), t("editor.formatNoEmmurt", { version: versioni.emmurt }))
        piglie
    }
    chist è testo = file[CHIAVE[aperto]]
    chist è arrecettato = arrecetta(aperto, testo)
    si (arrecettato === nisciun) {
        // A syntax error: the text stays as it is, the errors say why
        lancia()
    } sinnò si (arrecettato !== testo) {
        metti(editori[aperto], arrecettato)
    }
}

chist è editori = {
    "stile.cess": creaEditor({
        parent: pesca("editor-cess"),
        linguaggio: "cess",
        etichetta: t("editor.labelCess"),
        quannoCagna: (testo) => quannoCagna("stile.cess", testo),
        lancia: () => lancia(overo),
        arrecetta: arrecettaFile,
    }),
    "index.emmurt": creaEditor({
        parent: pesca("editor-paggena"),
        linguaggio: "emmurt",
        etichetta: t("editor.labelEmmurt"),
        quannoCagna: (testo) => quannoCagna("index.emmurt", testo),
        lancia: () => lancia(overo),
        arrecetta: arrecettaFile,
    }),
}

chist è schedeFile = tutti("[data-file-scheda]")

facc apriFile(nomme) {
    aperto = nomme
    pe ogni (chist è s dint schedeFile) {
        chist è si_ = s.dataset.fileScheda === nomme
        s.setAttribute("aria-selected", String(si_))
        s.tabIndex = si_ ? 0 : -1
        pesca(s.getAttribute("aria-controls")).hidden = !si_
    }
    editori[nomme].requestMeasure()
    scriviFormatta()
}

pe ogni (chist è [i, s] dint schedeFile.entries()) {
    s.addEventListener("click", () => apriFile(s.dataset.fileScheda))
    s.addEventListener("keydown", (evento) => {
        si (evento.key === "ArrowRight" || evento.key === "ArrowLeft") {
            evento.preventDefault()
            chist è prossima = schedeFile[(i + 1) % schedeFile.length]
            apriFile(prossima.dataset.fileScheda)
            prossima.focus()
        }
    })
}

// ---------- Tabs on phones

chist è telefono = matchMedia("(max-width: 767px)")

facc mostraScheda(nova) {
    scheda = nova
    pe ogni (chist è s dint tutti("[data-scheda]")) {
        s.setAttribute("aria-selected", String(s.dataset.scheda === nova))
    }
    chist è piccolo = telefono.matches
    pesca("pannello-codice").hidden = piccolo && nova !== "codice"
    pesca("pannello-uscita").hidden = piccolo && nova === "codice"
    pe ogni (chist è piezz dint tutti("[data-sezione]")) {
        piezz.hidden = piccolo && nova !== "codice" && piezz.dataset.sezione !== nova
        piezz.toggleAttribute("data-sola", piccolo && piezz.dataset.sezione === nova)
    }
    vistaCss.requestMeasure()
    editori[aperto].requestMeasure()
}

pe ogni (chist è s dint tutti("[data-scheda]")) {
    s.addEventListener("click", () => mostraScheda(s.dataset.scheda))
}
telefono.addEventListener("change", () => mostraScheda(scheda))

// ---------- Lessons

chist è scola = creaScola({
    vai: (i) => apriLezione(i),
    esci: () => esciDaScola(),
    metti: (nuovi) => {
        mettiFile(nuovi)
        lancia()
    },
})

// The comparison is asynchronous: it counts only if the lesson and the code are still the same
mo vir facc controllaLezione(html) {
    si (lezione === nisciun) {
        piglie
    }
    chist è l = LEZIONI[lezione]
    si (fatte.has(l.id)) {
        piglie
    }
    si (!soluzioni.has(l.id)) {
        soluzioni.set(l.id, fotografa(compila(l.soluzione).html ?? ""))
    }
    chist è lanciato = ultimoLanciato
    chist è [mio, giusto] = aspett Promise.all([fotografa(html), soluzioni.get(l.id)])
    si (lezione === nisciun || LEZIONI[lezione].id !== l.id || ultimoLanciato !== lanciato) {
        piglie
    }
    si (differenza(mio, giusto) === nisciun) {
        fatte.add(l.id)
        salva(FATTE, JSON.stringify([...fatte]))
        scola.mostra(lezione, fatte)
    }
}

facc apriLezione(i) {
    chist è indice = Math.min(Math.max(i, 0), LEZIONI.length - 1)
    si (sezione !== nisciun) {
        esciDaGuida()
    }
    lezione = indice
    esempio = ""
    pesca("impara").setAttribute("aria-pressed", "true")
    pesca("impara").title = t("header.tourExit")
    pesca("esempi-barra").hidden = overo
    scola.mostra(indice, fatte)
    chist è l = LEZIONI[indice]
    mettiFile(leggiFile(CODICE_LEZIONE + l.id) ?? l.partenza)
    apriFile(l.file)
    scriviEsempi()
    mostraScheda("codice")
    history.replaceState(nisciun, "", `#scola=${indice + 1}`)
    lancia()
}

facc esciDaScola() {
    lezione = nisciun
    scola.nasconde()
    pesca("impara").setAttribute("aria-pressed", "false")
    pesca("impara").title = t("header.tourOpen")
    pesca("esempi-barra").hidden = sfòls
    mettiFile(leggiFile(SALVATO) ?? ESEMPI[0])
    esempio = esempioD_e(file)
    scriviEsempi()
    history.replaceState(nisciun, "", location.pathname + location.search)
    lancia()
}

pesca("impara").addEventListener("click", () => {
    si (lezione !== nisciun) {
        esciDaScola()
        piglie
    }
    // Start again from the first lesson not done yet
    chist è prossima = LEZIONI.findIndex((l) => !fatte.has(l.id))
    apriLezione(prossima === -1 ? 0 : prossima)
})

// ---------- Guide

chist è guida = creaGuida({
    vai: (i) => apriGuida(i),
    apri: (nuovi) => {
        esciDaGuida()
        esempio = "proprio"
        mettiFile(nuovi)
        apriFile(nuovi.file)
        scriviEsempi()
        mostraScheda("codice")
        lancia()
    },
})

facc mostraGuida(si_) {
    pesca("banco").hidden = si_
    pesca("schede").hidden = si_
    pesca("barra-stato").hidden = si_
    pesca("azioni").hidden = si_
    chist è link = pesca("guida")
    link.href = si_ ? location.pathname + location.search : "#guida"
    link.querySelector("[data-t]").dataset.t = si_ ? "header.playground" : "header.guide"
    link.dataset.tAria = si_ ? "header.guideExit" : "header.guideLabel"
    link.dataset.tTitle = si_ ? "header.guideExit" : "header.guideOpen"
    link.querySelector("svg").outerHTML = icona(si_ ? "terminale" : "libro")
    traduci(link.parentElement)
}

facc apriGuida(i) {
    si (lezione !== nisciun) {
        esciDaScola()
    }
    sezione = Math.min(Math.max(i, 0), SEZIONI.length - 1)
    mostraGuida(overo)
    guida.mostra(sezione)
    history.replaceState(nisciun, "", `#guida=${SEZIONI[sezione].id}`)
}

facc esciDaGuida() {
    sezione = nisciun
    guida.nasconde()
    mostraGuida(sfòls)
    history.replaceState(nisciun, "", location.pathname + location.search)
    mostraScheda(scheda)
}

pesca("guida").addEventListener("click", (evento) => {
    // Ctrl-click or a middle click opens the guide in a new tab, as a link
    si (evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) {
        piglie
    }
    evento.preventDefault()
    si (sezione !== nisciun) {
        esciDaGuida()
    } sinnò {
        apriGuida(0)
    }
})

// ---------- Buttons and menus

pesca("esegui").addEventListener("click", () => lancia(overo))
pesca("formatta").addEventListener("click", arrecettaFile)
pesca("pulizza").addEventListener("click", () => {
    pesca("console").replaceChildren()
    contaConsole()
})

chist è automaticoSpunta = pesca("automatico")
automaticoSpunta.checked = automatico
automaticoSpunta.addEventListener("change", () => {
    automatico = automaticoSpunta.checked
    salva(AUTOMATICO, String(automatico))
    si (automatico && (!ultimoLanciato || !uguale(file, ultimoLanciato))) {
        lancia()
    }
})

// Code that is still an example keeps its name
facc esempioD_e(x) {
    si (uguale(x, ESEMPI[0])) {
        piglie ""
    }
    piglie ESEMPI.find((e) => uguale(e, x))?.id ?? "proprio"
}

pesca("esempi").addEventListener("change", (evento) => {
    chist è scigliuto = ESEMPI.find((x) => x.id === evento.target.value)
    si (!scigliuto) {
        piglie
    }
    esempio = scigliuto.id
    mettiFile(scigliuto)
    scriviEsempi()
    lancia()
})

pesca("condividi").addEventListener("click", mo vir () => {
    chist è link = aspett linkPe(file)
    history.replaceState(nisciun, "", link)
    pruvamm {
        aspett navigator.clipboard.writeText(link)
        avvisa(t("share.copied"), t("share.copiedDesc"))
    } e si schiatta (e) {
        avvisa(t("share.failed"), link)
    }
})

pesca("copia-css").addEventListener("click", mo vir () => {
    chist è scritta = pesca("copia-css").querySelector("[data-t]")
    pruvamm {
        aspett navigator.clipboard.writeText(vistaCss.state.doc.toString())
        scritta.textContent = t("output.copied")
    } e si schiatta (e) {
        scritta.textContent = t("share.failed")
    }
    setTimeout(() => {
        scritta.textContent = t("output.copyCss")
    }, 2000)
})

facc scriviVersioni() {
    si (versioni) {
        pesca("versione").title = t("editor.versions", versioni)
    }
}

quannoCagnaLingua(() => {
    scriviTemi()
    scriviEsempi()
    scriviFormatta()
    scriviVersioni()
    ultimoStato()
    contaConsole()
    si (lezione !== nisciun) {
        scola.scrivi()
    }
    si (sezione !== nisciun) {
        mostraGuida(overo)
        guida.scrivi()
    }
})

// ---------- Start

mettiIcone()
traduci()
scriviTemi()
scriviEsempi()
apriFile(aperto)
mostraScheda("codice")
contaConsole()
ultimoStato()

chist è dalHash = nu bell URLSearchParams(location.hash.slice(1))
chist è dalLink = aspett codiceDalLink()
mettiFile(dalLink ?? leggiFile(SALVATO) ?? ESEMPI[0])
esempio = dalLink ? "proprio" : esempioD_e(file)
scriviEsempi()

pruvamm {
    chist è caricato = aspett carica()
    versioni = caricato.versioni
    pesca("versione").textContent = versioni.parocss
    scriviVersioni()
    imparaParole(caricato.paggena, caricato.cess, caricato.nomi)
    preparaAiuto(caricato.nomi, caricato.cess)
    pronto = overo
    pe ogni (chist è b dint [pesca("esegui"), pesca("formatta")]) {
        b.disabled = sfòls
    }
    scriviFormatta()
    pesca("carica").hidden = overo
    ultimoStato = () => stato("pronto", t("status.ready"))
    si (dalHash.has("scola")) {
        apriLezione(Number.parseInt(dalHash.get("scola"), 10) - 1 || 0)
    } sinnò si (dalHash.has("guida")) {
        apriGuida(Math.max(SEZIONI.findIndex((s) => s.id === dalHash.get("guida")), 0))
        lancia()
    } sinnò {
        lancia()
    }
} e si schiatta (e) {
    pesca("carica").replaceChildren(crea("strong", "blocco scrittura-peso-600 culore-sbaglio-scritta", t("error.load")), crea("span", "blocco margine-ncoppa-1 larghezza-massima-md allinea-testo-miezo", t("error.loadMessage")))
    pesca("carica").classList.add("direzione-colonna")
    ultimoStato = () => stato("sbaglio", t("status.loadFailed"))
    ultimoStato()
    iett e
}
