// Compiling and showing: the page with htmlemmurt, the .cess with par-o-css
// and the page's classes, the CSS in the page, the preview with its console.

chiamm * comme emmurt da "htmlemmurt/web"
chiamm { init, compile, format, scan, vocabulary, names, version } da "par-o-css/web"

// @chiamm "pezzi/carta.cess" in the playground reads examples/pezzi
chist è FILE = import.meta.glob("../../../examples/pezzi/*.cess", { query: "?raw", import: "default", eager: overo })
chist è PEZZI = Object.fromEntries(Object.entries(FILE).map(([p, testo]) => ["pezzi/" + p.split("/").pop(), testo]))

facc leggi(percorso) {
    piglie PEZZI[percorso.replace(/^\.?\//, "")] ?? nisciun
}

/** Loads both WebAssembly compilers; gives versions, vocabularies and classes. */
mann for mo vir facc carica() {
    aspett Promise.all([emmurt.init(), init()])
    piglie {
        versioni: { parocss: version(), emmurt: emmurt.version() },
        paggena: emmurt.vocabulary(),
        cess: vocabulary(),
        nomi: names(),
    }
}

// The CSS goes where the page links stile.cess, or at the end of its <head>
facc conStile(paggena, foglio) {
    // "</style" in a CSS string would close the tag early
    chist è stile = `<style>${foglio.replaceAll("</style", "<\\/style")}</style>`
    chist è link = /<link\b[^>]*\bhref=["']?(?:\.\/)?stile\.cess["']?[^>]*>/i
    si (link.test(paggena)) {
        piglie paggena.replace(link, () => stile)
    }
    // A fragment without <cristian> has no <!DOCTYPE>: without it the browser uses quirks mode
    chist è doctype = /^\s*<!doctype/i.test(paggena) ? "" : "<!DOCTYPE html>"
    chist è dove = paggena.search(/<\/head>|<body\b/i)
    piglie doctype + (dove === -1 ? stile + paggena : paggena.slice(0, dove) + stile + paggena.slice(dove))
}

/**
 * Compiles the page, and the .cess with the page's classes. Gives the HTML
 * with the CSS in it (null when there are errors), the CSS, the errors of
 * both and the milliseconds. Each error names its file: index.emmurt,
 * stile.cess or a piece.
 */
mann for facc compila({ cess, paggena }) {
    chist è inizio = performance.now()
    chist è p = emmurt.compile(paggena, { filename: "index.emmurt", inline: overo })
    chist è c = compile(cess, { filename: "stile.cess", classes: scan(paggena), read: leggi })
    chist è sbagli = [...p.errors, ...c.errors]
    piglie {
        html: sbagli.length === 0 ? conStile(p.html, c.css) : nisciun,
        css: c.css,
        sbagli,
        ms: performance.now() - inizio,
    }
}

/**
 * htmlemmurt 0.4.0 on npm has no format (it is merged, not released yet): the
 * build warns that it is undefined, and Formatta says so on index.emmurt.
 */
mann for chist è arrecettaPaggena = typeof emmurt.format === "function" ? emmurt.format : nisciun

/** The file formatted as parocss fmt and emmurt fmt do, or null (a syntax error, or no formatter). */
mann for facc arrecetta(file, testo) {
    si (file === "stile.cess") {
        piglie format(testo)
    }
    piglie arrecettaPaggena ? arrecettaPaggena(testo) : nisciun
}

// A script in the page that sends its console and errors to the playground
chist è SPIA = `<script>(() => {
  const manna = (tipo, cose) => parent.postMessage({ parocss: tipo, cose: cose.map((c) => {
    try { return typeof c === "string" ? c : JSON.stringify(c) } catch { return String(c) }
  }) }, "*");
  for (const k of ["log", "info", "warn", "error"]) {
    const vecchio = console[k];
    console[k] = (...a) => { manna(k, a); vecchio.apply(console, a) };
  }
  addEventListener("error", (e) => parent.postMessage({ parocss: "runtime", name: e.error?.name ?? "Error", message: e.message }, "*"));
  addEventListener("unhandledrejection", (e) => parent.postMessage({ parocss: "runtime", name: e.reason?.name ?? "Error", message: String(e.reason?.message ?? e.reason) }, "*"));
  // A form in the frame has nowhere to go: the console says where it would
  addEventListener("submit", (e) => {
    e.preventDefault();
    const dati = [...new FormData(e.target)].map(([k, v]) => k + "=" + v).join(" ");
    manna("info", ["📨 " + (e.target.method || "get").toUpperCase() + " " + (e.target.getAttribute("action") || "") + (dati ? " " + dati : "")]);
  });
})()</script>`

facc conSpia(paggena) {
    chist è capa = paggena.indexOf("<head>")
    si (capa === -1) {
        piglie SPIA + paggena
    }
    chist è dopo = capa + "<head>".length
    piglie paggena.slice(0, dopo) + SPIA + paggena.slice(dopo)
}

/**
 * A frame with no access to the playground (scripts only). `scrive(tipo, testo)`
 * gets the page's console: log, info, warn, error.
 */
mann for facc creaAnteprima(parent, scrive) {
    chist è fenestella = document.createElement("iframe")
    fenestella.title = "Anteprima"
    fenestella.setAttribute("sandbox", "allow-scripts allow-modals allow-forms allow-popups allow-popups-to-escape-sandbox")
    parent.append(fenestella)
    window.addEventListener("message", (evento) => {
        chist è d = evento.data
        si (evento.source !== fenestella.contentWindow || !d?.parocss) {
            piglie
        }
        si (d.parocss === "runtime") {
            scrive("error", emmurt.runtimeError({ name: d.name, message: d.message }))
        } sinnò {
            scrive(d.parocss, d.cose.join(" "))
        }
    })
    piglie {
        mostra: (html) => {
            fenestella.srcdoc = conSpia(html)
        },
    }
}
