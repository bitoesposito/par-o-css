/* 'O tema, 'a pulizia e 'e classi ca usa 02_pizzeria.emmurt */
@chiamm "par-o-css"

@tema {
  --culore-pummarola-500: oklch(58% 0.21 28)
  --culore-pummarola-600: oklch(52% 0.2 28)
  --culore-mozzarella: #fffdf7
  --scrittura-sans: "Atkinson Hyperlegible", system-ui, sans-serif
}

@chiamm "pezzi/carta.cess"

citofono.ordina {
  @applica spazio-x-4 spazio-y-2 bordo-tunno-lg sfunno-pummarola-500 culore-janco
  @applica passanno:sfunno-pummarola-600 fuoco-visibile:contorno-2
  transizione: sfunno-culore 0.2s facile
}
